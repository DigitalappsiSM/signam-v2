rules_version = '2';

// Reglas de seguridad de Cloud Storage para SIGNAM V2.
//
// Se conservan los archivos originales importados (calendarios Liverpool y
// maestros Admira) y los CSV/ZIP exportados. El rol se lee de los custom claims
// del token (`request.auth.token.role`).

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return isSignedIn() ? request.auth.token.get('role', '') : '';
    }

    // FASE ACTUAL (pre-lanzamiento): homologada a firestore.rules — cualquier
    // usuario autenticado (invitado por el administrador) puede leer y subir los
    // originales de importación (Liverpool, Ekon y Digital), sin depender de que
    // el custom claim de rol ya esté en el token. Antes de liberar al equipo se
    // restaurará el control por rol (`role() in [...]`, ver permissions.ts).
    function canRead() {
      return isSignedIn();
    }

    function canWriteImports() {
      return isSignedIn();
    }

    // Archivos originales de importación (se conservan tal cual).
    // Solo creación: no se permite sobrescribir ni eliminar un archivo
    // original ya subido (posiblemente por otro operador), para no destruir
    // la fuente conservada que se necesita para auditoría o reprocesamiento.
    match /imports/{importId}/{fileName} {
      allow read: if canRead();
      allow create: if canWriteImports();
      allow update, delete: if false;
    }

    // Originales del flujo multirretailer, aislados de imports Liverpool.
    // Inmutables después de crearse para preservar la auditoría.
    match /digital-imports/{batchId}/{fileName} {
      allow read: if canRead();
      allow create: if canWriteImports()
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';
      allow update, delete: if false;
    }

    // Exportaciones (CSV y ZIP). Escritas por Cloud Functions.
    match /exports/{exportId}/{fileName} {
      allow read: if canRead();
      allow write: if false;
    }

    // Cerrado por defecto.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
