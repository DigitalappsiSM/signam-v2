rules_version = '2';

// Reglas de seguridad de Cloud Firestore para SIGNAM V2.
//
// FASE ACTUAL (pre-lanzamiento, en pruebas): cualquier usuario autenticado
// (creado por el administrador en Firebase Authentication) puede leer y escribir
// las colecciones de trabajo. La app es privada y de acceso por invitación.
//
// OBJETIVO antes de liberar al equipo: control por ROL (admin/operator/viewer).
// Cuando exista el modelo de roles (documento `users/{uid}` con `role`, o custom
// claims), se sustituirá `isSignedIn()` por las funciones de rol de abajo, que
// ya quedan preparadas. La eliminación física de pantallas se prohíbe incluso
// en pruebas (se inactivan conservando su historial).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // --- Preparado para el control por rol (aún no aplicado en esta fase) ---
    function userRole() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }

    // Perfiles de usuario: cada quien lee el suyo; en esta fase, cualquier
    // usuario autenticado puede administrarlos (se restringirá a admin).
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Catálogo Admira. Sin eliminación física: las pantallas se inactivan
    // (metadata.active=false) conservando su historial, de modo que una campaña
    // que solicite una pantalla inactiva pueda producir la incidencia explícita.
    match /screens/{screenId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    // Campañas importadas del calendario Liverpool.
    match /campaigns/{campaignId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Validaciones de importación: creadas por quien importa; inmutables luego.
    match /importValidations/{importId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Consolidaciones.
    match /consolidations/{consolidationId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Exportaciones CSV: snapshot inmutable una vez creado.
    match /csvExports/{exportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Auditoría: inmutable (solo se agrega, nunca se edita ni se borra).
    match /auditEvents/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Cerrado por defecto para cualquier otra ruta.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
