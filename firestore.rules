rules_version = '2';

// Reglas de seguridad de Cloud Firestore para SIGNAM V2.
//
// FASE ACTUAL (pre-lanzamiento, en pruebas): cualquier usuario autenticado
// (creado por el administrador en Firebase Authentication) puede leer y escribir
// las colecciones de trabajo. La app es privada y de acceso por invitación.
//
// OBJETIVO antes de liberar al equipo: control por ROL (admin/operator/viewer).
// Cuando exista el modelo de roles (documento `users/{uid}` con `role`, o custom
// claims), se sustituirá `isSignedIn()` por las funciones de rol de abajo, que
// ya quedan preparadas. La eliminación física de pantallas se prohíbe incluso
// en pruebas (se inactivan conservando su historial).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin resuelto desde el custom claim del token (fuente de verdad del rol).
    function isAdmin() {
      return isSignedIn() && request.auth.token.get('role', '') == 'admin';
    }
    function isOperator() {
      return isSignedIn() && request.auth.token.get('role', '') == 'operator';
    }
    function canOperateDigital() { return isAdmin() || isOperator(); }
    function validDigitalLifecycle(data) {
      return data.lifecycleStatus in ['active', 'cancelled']
        && (data.cancellationReason == null || data.cancellationReason is string);
    }

    // Operación Digital Signage multirretailer. Estas colecciones son un límite
    // explícito: ninguna regla ni escritura reutiliza campaigns/screens/Admira.
    match /digitalSupportCatalog/{profileId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && request.resource.data.sourceSchema == 'ekon-campaign-tracking-v1'
        && request.resource.data.active is bool;
      allow update: if isAdmin() && request.resource.data.sourceSchema == resource.data.sourceSchema
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }
    match /digitalImportBatches/{batchId} {
      allow read: if isSignedIn();
      allow create, update: if canOperateDigital() && request.resource.data.status in
        ['analyzing','pending-scope','pending-resolutions','processing','completed','failed']
        && request.resource.data.sourceSchema == 'ekon-campaign-tracking-v1';
      allow delete: if false;
    }
    match /digitalPlacementRows/{rowId} {
      allow read: if isSignedIn();
      allow create: if canOperateDigital() && request.resource.data.recordKey is string;
      allow update: if canOperateDigital()
        && request.resource.data.recordKey == resource.data.recordKey
        && request.resource.data.firstBatchId == resource.data.firstBatchId;
      allow delete: if false;
    }
    match /digitalOperationalItems/{itemId} {
      allow read: if isSignedIn();
      allow create: if canOperateDigital() && request.resource.data.source == 'ekon-campaign-tracking';
      allow update: if canOperateDigital()
        && request.resource.data.operationalKey == resource.data.operationalKey
        && request.resource.data.firstBatchId == resource.data.firstBatchId;
      allow delete: if false;
    }
    match /digitalOperationalTracking/{itemId} {
      allow read: if isSignedIn();
      allow create: if canOperateDigital() && request.resource.data.operationalItemId == itemId
        && validDigitalLifecycle(request.resource.data);
      allow update: if canOperateDigital()
        && request.resource.data.operationalItemId == resource.data.operationalItemId
        && request.resource.data.createdAt == resource.data.createdAt
        && validDigitalLifecycle(request.resource.data);
      allow delete: if false;
    }
    match /digitalImportResolutions/{resolutionId} {
      allow read: if isSignedIn(); allow create: if canOperateDigital(); allow update, delete: if false;
    }
    match /digitalPlacementRevisions/{revisionId} {
      allow read: if isSignedIn(); allow create: if canOperateDigital(); allow update, delete: if false;
    }
    match /digitalReportExports/{exportId} {
      allow read: if isSignedIn(); allow create: if canOperateDigital(); allow update, delete: if false;
    }

    // --- Preparado para el control por rol (aún no aplicado en esta fase) ---
    function userRole() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }

    // Perfiles de usuario (espejo legible del rol). La asignación de roles se
    // hace exclusivamente desde Cloud Functions con el Admin SDK (que ignora
    // estas reglas y establece el custom claim, fuente de verdad). Por eso el
    // cliente no escribe aquí: cada quien lee su propio perfil y un admin puede
    // leer todos para la pantalla de administración.
    match /users/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    // Catálogo Admira. La acción normal es INACTIVAR (metadata.active=false),
    // que conserva el historial. La eliminación física se permite para limpiar
    // registros de prueba o cargados por error; no debe usarse con pantallas ya
    // referenciadas por exportaciones. Antes de liberar, se restringirá a admin.
    match /screens/{screenId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Campañas importadas del calendario Liverpool.
    match /campaigns/{campaignId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();

      // Bitácora append-only de correcciones manuales. El documento padre se
      // actualiza en la misma transacción; el historial nunca se edita ni borra.
      match /corrections/{correctionId} {
        allow read: if isSignedIn();
        allow create: if (isAdmin() || isOperator())
          && request.resource.data.campaignId == campaignId
          && request.resource.data.reason is string
          && request.resource.data.comment is string
          && request.resource.data.changes is list
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.actorEmail is string
          && request.resource.data.at is int;
        allow update, delete: if false;
      }
    }

    // Memoria de resoluciones humanas para comentarios del calendario que no
    // incluyen números de tienda. Evita pedir la misma confirmación en cada
    // reimportación; nunca concede por sí sola acceso a campañas o pantallas.
    match /storeCommentResolutions/{resolutionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    // Asociación manual campaña Liverpool ↔ número de campaña Ekon. Colección
    // separada de `campaigns`: la importación nunca la toca y sobrevive a
    // reimportaciones. El documento usa el campaignId estable; un mismo número
    // Ekon puede repetirse en varias campañas (muchos-a-uno), pero editar un
    // flight no modifica a los demás.
    match /campaignEkonLinks/{campaignId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Seguimiento operativo de campañas: colección INDEPENDIENTE de `campaigns`.
    //
    // FASE ACTUAL (pre-lanzamiento): igual que el resto de colecciones, cualquier
    // usuario autenticado puede escribir. El control por ROL (write solo
    // admin/operator, ver `tracking.write` en permissions.ts) se aplicará antes
    // de liberar, cuando los custom claims de rol estén provisionados —
    // sustituyendo `isSignedIn()` por la comprobación de rol de abajo.
    //
    // Se conservan ya las validaciones estructurales: sin eliminación física
    // desde el cliente y `campaignNameKey`/`createdAt`/`createdBy*` inmutables
    // tras la creación.
    //
    // Ciclo de vida operativo (Activa/Cancelada): el cliente siempre escribe un
    // `lifecycleStatus` válido y sus metadatos (el cliente normaliza los
    // documentos legacy antes de persistir). El motivo de cancelación admite
    // texto vacío, que se guarda como `null`. La lectura NO valida estos campos,
    // por lo que los documentos anteriores siguen siendo legibles.
    //
    // function canWriteTracking() {
    //   return isSignedIn() &&
    //     (request.auth.token.get('role', '') == 'admin'
    //      || request.auth.token.get('role', '') == 'operator');
    // }
    function validLifecycle(data) {
      return data.lifecycleStatus in ['active', 'cancelled']
        && data.lifecycleUpdatedAt is int
        && data.lifecycleUpdatedByUid is string
        && data.lifecycleUpdatedByEmail is string
        && (data.cancellationReason == null
            || data.cancellationReason is string);
    }
    function validCampaignReference(data) {
      return !('campaignId' in data) || data.campaignId is string;
    }
    match /campaignOperationalTracking/{campaignId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.campaignNameKey is string
        && request.resource.data.classification in ['institutional', 'provider']
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int
        && validCampaignReference(request.resource.data)
        && validLifecycle(request.resource.data);
      allow update: if isSignedIn()
        && request.resource.data.classification in ['institutional', 'provider']
        && request.resource.data.campaignNameKey == resource.data.campaignNameKey
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdByEmail == resource.data.createdByEmail
        && validCampaignReference(request.resource.data)
        && (!('campaignId' in resource.data)
            || request.resource.data.campaignId == resource.data.campaignId)
        && validLifecycle(request.resource.data);
      allow delete: if false;
    }

    // --- Integración Ekon (colecciones separadas de Liverpool/Master) ---
    //
    // FASE ACTUAL (pre-lanzamiento): cualquier usuario autenticado puede leer y
    // escribir, como el resto de colecciones de trabajo. El control por ROL
    // (ekon.import a admin/operator, ver permissions.ts) se aplicará antes de
    // liberar, sustituyendo `isSignedIn()` por la comprobación de rol. Estas
    // colecciones NUNCA modifican `campaigns`, el catálogo ni el seguimiento.

    // Lotes de importación Ekon (metadatos: nombre, hash, periodos, totales).
    // El estado de lote (parsing/pending_confirmation/processing/completed/failed)
    // vive en el documento; conciliación y fallback consumen solo completados.
    // No se persiste el archivo crudo en Firestore (ver ekonImports.ts).
    match /ekonImportBatches/{batchId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.status in
           ['parsing', 'pending_confirmation', 'processing', 'completed', 'failed'];
      // Sin borrado físico desde el cliente (conserva historial auditable).
      allow delete: if false;
    }

    // Asignaciones Ekon vigentes (id = huella estable de la asignación). Las
    // ausentes se conservan con active:false (No incluida); no se borran.
    match /ekonAssignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    // Historial de revisiones de asignaciones Ekon: append-only e inmutable.
    match /ekonRevisions/{revisionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Validaciones de importación: creadas por quien importa; inmutables luego.
    match /importValidations/{importId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Consolidaciones.
    match /consolidations/{consolidationId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Exportaciones CSV: snapshot inmutable una vez creado.
    match /csvExports/{exportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Auditoría: inmutable (solo se agrega, nunca se edita ni se borra).
    match /auditEvents/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Resoluciones de fechas ambiguas confirmadas al importar (memoria estable
    // para que la reimportación las respete). Se crean/actualizan; no se borran.
    match /dateResolutions/{resolutionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    // Cerrado por defecto para cualquier otra ruta.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
