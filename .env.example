# SIGNAM V2 — variables de entorno del frontend (Vite).
# Copia este archivo a `.env` y completa los valores del proyecto Firebase
# de producción (signam-v2-prod), que es el entorno de trabajo actual.
# NUNCA confirmes `.env`, cuentas de servicio, llaves privadas ni tokens en Git.

# --- Configuración de Firebase (obligatoria para habilitar servicios) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=signam-v2-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=signam-v2-prod
VITE_FIREBASE_STORAGE_BUCKET=signam-v2-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Emulator Suite (desarrollo local) ---
# Pon "true" para conectar la app a los emuladores en lugar de servicios reales.
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
